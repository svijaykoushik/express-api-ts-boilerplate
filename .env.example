# DB Properties
DB_TYPE= sqlite
TYPEORM_DATABASE= play_ground.db
TYPEORM_LOG_QUERY= false

# Connection properties for postgres/mysql (used if DB_TYPE is not sqlite)
# DB_HOST= localhost
# DB_PORT= 5432
# DB_USERNAME= root
# DB_PASSWORD= password
# DB_POOL_MAX= 10

# APP

APP_PORT= 5050
APP_URL= 0.0.0.0

#Docs
SWAGGER_PORT= 5050
SWAGGER_DOMAIN= localhost

# Auth
ACCESS_TOKEN_SECRET= your-256-bit-long-secret
REFRESH_TOKEN_SECRET= your-256-bit-long-refresh-secret